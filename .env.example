# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nobre"

# Endereço público do sistema (usado nos links dos e-mails de recuperação de senha).
APP_URL="http://localhost:3000"

# Administrador da empresa, criado no primeiro start (somente se ainda não existir nenhum usuário).
# A senha precisa ter 10+ caracteres com maiúscula, minúscula e número; a troca é exigida no primeiro acesso.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@churrasconobre.local"
ADMIN_PASSWORD="Troque-Esta-Senha-1"

# Console do fornecedor (bloquear/liberar o sistema, módulos, vencimento, histórico).
# Fica em um caminho do próprio domínio, ex.: https://seu-dominio/sistema-admin
# Escolha um caminho pouco óbvio. Use "off" para desativar. (Padrão: /sistema-admin)
PLATFORM_ADMIN_PATH="/sistema-admin"
# Opcional: domínio(s) dedicado(s) ao console, separados por vírgula (exige DNS/certificado próprios).
# PLATFORM_ADMIN_HOSTS="admin.exemplo.com.br"
# Conta master do fornecedor, criada no primeiro start (protegida contra desativação).
PLATFORM_ADMIN_NAME="Fornecedor"
PLATFORM_ADMIN_EMAIL="fornecedor@exemplo.com.br"
PLATFORM_ADMIN_PASSWORD="Troque-Esta-Senha-Longa-1"

# E-mail (recuperação de senha). Sem SMTP_HOST o link é apenas registrado no log do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Churrasco Nobre <nao-responder@exemplo.com.br>"

# Confiar no cabeçalho X-Forwarded-For do proxy (Easypanel/Traefik) para identificar o IP do cliente
# (limite de tentativas de login, auditoria, sessões). Atrás do Easypanel use "true" com 1 proxy.
# Se houver outro proxy na frente (ex.: Cloudflare), aumente TRUST_PROXY_HOPS para 2.
# Fora de um proxy, deixe "false": o cabeçalho poderia ser forjado.
TRUST_PROXY="true"
TRUST_PROXY_HOPS="1"

# Fuso horário usado nos filtros de data ("hoje", "mês atual")
TZ="America/Sao_Paulo"
